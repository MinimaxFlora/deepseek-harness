# Copy to .env, then `docker compose up -d`.

# ── 名称与端口 ────────────────────────────────────────────────────────────────
CONTAINER_NAME=deepseek-harness
# HTTPS 前门端口（容器内 Caddy 监听 8443，改左侧即可）
DSH_HTTPS_PORT=8443

# ── 访问与认证 ────────────────────────────────────────────────────────────────
# 浏览器要输入的名字：宿主机局域网 IP（如 192.168.1.10）或域名。
# 它同时用于：日志里打印访问地址、/api 信任围栏、Caddy 签发自签证书。
HTTPS_ACCESS_HOST=
# 可选 HTTP Basic Auth（两个都填才生效）。留空则只用 dsh 自带的 token + cookie。
# 密码请用强口令：建议密码再套一层，这是暴露在网络上的入口。
DSH_AUTH_USERNAME=
DSH_AUTH_PASSWORD=

# ── 网络 ─────────────────────────────────────────────────────────────────────
# 复用已有网络时填网络名，例如 1Panel 应用商店的 1panel-network。
DSH_NETWORK=dsh-network
# 额外需要信任的 authority（逗号分隔），例如再套一层反代时的域名。
DSH_TRUSTED_HOSTS=

# ── 模型凭据（可选）──────────────────────────────────────────────────────────
# dsh 的凭据是「环境变量名引用」：这里给出的密钥会在设置页显示为只读来源。
# 留空则进 UI 自己配，凭据落在 ./data/dsh/.credentials.yaml。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── TLS 进阶 ─────────────────────────────────────────────────────────────────
# internal（默认，自签，适合内网 IP） | acme（真域名，需映射 80/443） | files（自带证书）
DSH_TLS_MODE=internal
DSH_ACME_EMAIL=
# DSH_TLS_CERT=/data/caddy/tls/fullchain.pem
# DSH_TLS_KEY=/data/caddy/tls/privkey.pem

# ── 其它 ─────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
DSH_TAG=0.1.5-rc.1
DSH_VERSION=0.1.5-rc.1
# 需要硬开 Node 内部模块（例如换 musl 基础镜像）时：--expose-internals
DSH_NODE_FLAGS=
# 追加到 web app 之后的参数
DSH_EXTRA_ARGS=
