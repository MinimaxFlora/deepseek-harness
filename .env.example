# Copy to .env, then `docker compose up -d`.

# ── 名称与端口 ────────────────────────────────────────────────────────────────
CONTAINER_NAME=deepseek-harness
# HTTPS 前门端口（容器内 Caddy 监听 8443，改左侧即可）
DSH_HTTPS_PORT=8443

# ── 访问与认证 ────────────────────────────────────────────────────────────────
# 浏览器要输入的名字：
#   填域名（如 dsh.example.com）→ 容器内 Caddy 自动申请 Let's Encrypt 真证书，
#                                 此时把 DSH_TLS_MODE=acme，并对外映射 80 + 443
#   填 IP（如 192.168.1.10）或留空 → 容器内部 CA 自签，映射 8443 即可
# 它同时用于：日志里打印访问地址、/api 信任围栏、Caddy 证书签名对象。
# 用 install.sh 安装时这一步是向导自动完成的，无需手改。
HTTPS_ACCESS_HOST=
# 认证：dsh 自带「进程 token + 持久 cookie」，不需要额外账号密码。
# 首次部署后用日志里带 ?token= 的地址打开一次（install.sh 会直接打印可用链接）。

# ── 网络 ─────────────────────────────────────────────────────────────────────
# 复用已有网络时填网络名，例如 1Panel 应用商店的 1panel-network。
DSH_NETWORK=dsh-network
# 额外需要信任的 authority（逗号分隔），例如再套一层反代时的域名。
DSH_TRUSTED_HOSTS=

# ── 模型凭据（可选）──────────────────────────────────────────────────────────
# dsh 的凭据是「环境变量名引用」：这里给出的密钥会在设置页显示为只读来源。
# 留空则进 UI 自己配，凭据落在 ./data/dsh/.credentials.yaml。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── TLS 进阶 ─────────────────────────────────────────────────────────────────
# internal（自签，IP 场景默认） | acme（域名场景，需 80/443 可达） | files（自带证书）
# 注：用 install.sh 时脚本会按你填的是域名还是 IP 自动设好这一项。
DSH_TLS_MODE=internal
DSH_ACME_EMAIL=
# DSH_TLS_CERT=/data/caddy/tls/fullchain.pem
# DSH_TLS_KEY=/data/caddy/tls/privkey.pem

# ── 其它 ─────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
DSH_TAG=0.1.5-rc.1
DSH_VERSION=0.1.5-rc.1
# 需要硬开 Node 内部模块（例如换 musl 基础镜像）时：--expose-internals
DSH_NODE_FLAGS=
# 追加到 web app 之后的参数
DSH_EXTRA_ARGS=
